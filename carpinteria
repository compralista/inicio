<!-- LIBRERÍA AOS PARA ANIMACIONES -->
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

<script>
// --- LÓGICA MODO OSCURO (INDEX 23) ---
const themeToggleBtn = document.getElementById('theme-toggle');
const htmlElement = document.documentElement;

const savedTheme = localStorage.getItem('theme');
const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
    htmlElement.setAttribute('data-theme', 'dark');
}

function toggleTheme() {
    const currentTheme = htmlElement.getAttribute('data-theme');
    if (currentTheme === 'dark') {
        htmlElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
    } else {
        htmlElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
    }
}
themeToggleBtn.addEventListener('click', toggleTheme);

// --- VARIABLES GLOBALES DEL INDEX 26 ---
let allCards = [];
let currentPage = 1;
const cardsPerPage = 15;
const scriptURL = "https://script.google.com/macros/s/AKfycbx-VnsVDdD8_QDBJxGBpwPs_3RZDqtSnoGAvZM2RG_xkcCuVwixTuWMlo3tLHZu4nyf/exec";

// --- LÓGICA DE FAVORITOS (LOCALSTORAGE) ---
let misFavoritos = JSON.parse(localStorage.getItem('userFavoritos')) || [];
let viendoSoloFavoritos = false;

function guardarFavorito(nombreNegocio) {
    if (misFavoritos.includes(nombreNegocio)) {
        misFavoritos = misFavoritos.filter(fav => fav !== nombreNegocio);
    } else {
        misFavoritos.push(nombreNegocio);
    }
    localStorage.setItem('userFavoritos', JSON.stringify(misFavoritos));
    actualizarBotonesCorazon();
    if (viendoSoloFavoritos) aplicarFiltros(); 
}

function actualizarBotonesCorazon() {
    allCards.forEach(card => {
        const nombre = card.getAttribute('data-nombre');
        const btn = card.querySelector('.btn-favorito');
        const icon = btn.querySelector('i');
        
        if (misFavoritos.includes(nombre)) {
            btn.classList.add('activo');
            icon.classList.remove('far'); 
            icon.classList.add('fas');    
        } else {
            btn.classList.remove('activo');
            icon.classList.remove('fas');
            icon.classList.add('far');
        }
    });
}

// --- LÓGICA DE HORARIOS ---
function checkHorario(card){
    const ahora = new Date();
    const dia = ahora.getDay();
    const horaMinutos = ahora.getHours()*60 + ahora.getMinutes();
    const dias = ["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];
    const hoy = card.getAttribute('data-' + dias[dia].toLowerCase()) || 'Cerrado';
    
    if(hoy.toLowerCase().includes('cerrado')) return {estado:'cerrado', texto:'Cerrado ahora'};
    
    const bloques = hoy.split(',').map(b=>b.trim());
    for(const b of bloques){
        let [ini, fin] = b.split('-');
        if(!ini || !fin) continue;
        if(!ini.includes(':')) ini += ':00';
        if(!fin.includes(':')) fin += ':00';
        const [hI,mI]=ini.split(':').map(Number); 
        const [hF,mF]=fin.split(':').map(Number);
        let inicio = hI*60+mI; 
        let cierre = hF*60+mF; 
        if(cierre < inicio) cierre += 1440;
        
        if(horaMinutos >= inicio && horaMinutos < cierre) return {estado:'abierto', texto:`Abierto hasta ${fin}`};
    }
    return {estado:'cerrado', texto:'Cerrado ahora'};
}

function actualizarEstados(){
    allCards.forEach(card=>{
        const res = checkHorario(card);
        const estadoSpan = card.querySelector('.estado');
        estadoSpan.textContent = res.texto;
        estadoSpan.classList.remove('abierto','cerrado');
        estadoSpan.classList.add(res.estado);
        
        const diasSemana = ["Lunes","Martes","Miércoles","Jueves","Viernes","Sábado","Domingo"];
        const diaActual = new Date().getDay(); 
        const diaIndex = diaActual === 0 ? 6 : diaActual - 1; 

        const nombreDiaHoy = diasSemana[diaIndex];
        const horarioHoy = card.getAttribute('data-'+nombreDiaHoy.toLowerCase());
        
        card.querySelector('.horarios-concisos').innerHTML = `
            <strong>Hoy (${nombreDiaHoy}):</strong> ${horarioHoy ? horarioHoy : 'Consultar'}
        `;
    });
}

// --- PAGINACIÓN ---
function mostrarPagina(cards, page=1){
    const container = document.getElementById('negocios-container');
    container.innerHTML = '';
    
    if(cards.length === 0) {
        container.innerHTML = `<div style="width:100%; grid-column: 1 / -1; text-align:center; padding:60px 20px; color:var(--text-gray);">
            <i class="far fa-frown" style="font-size:3.5rem; margin-bottom:15px; color:var(--primary-color);"></i>
            <h3 style="font-size:1.4rem; font-weight:700; color:var(--text-dark);">No encontramos negocios</h3>
            <p>${viendoSoloFavoritos ? 'Aún no tienes favoritos guardados.' : 'Intenta con otro filtro de búsqueda.'}</p>
        </div>`;
        document.getElementById('paginador').innerHTML = '';
        return;
    }

    const start = (page-1)*cardsPerPage;
    const end = start+cardsPerPage;
    const pageCards = cards.slice(start, end);
    
    pageCards.forEach((c, index) => {
        c.style.animation = `fadeIn 0.4s ease forwards ${index * 0.05}s`;
        c.style.opacity = '0';
        container.appendChild(c);
    });

    const pagDiv = document.getElementById('paginador');
    pagDiv.innerHTML = '';
    const totalPages = Math.ceil(cards.length/cardsPerPage);
    if(totalPages > 1){
        for(let i=1;i<=totalPages;i++){
            const btn = document.createElement('button');
            btn.textContent = i;
            if(i===page) btn.classList.add('active');
            btn.addEventListener('click',()=>{currentPage=i; mostrarPagina(cards,currentPage); window.scrollTo({top: 0, behavior: 'smooth'});});
            pagDiv.appendChild(btn);
        }
    }
}

// Animación CSS JS
const styleSheet = document.createElement("style");
styleSheet.innerText = `@keyframes fadeIn { to { opacity: 1; transform: translateY(0); } from { opacity: 0; transform: translateY(12px); } }`;
document.head.appendChild(styleSheet);

// --- FILTROS ---
function aplicarFiltros(){
    let filtrados = allCards;
    const cat = document.getElementById('filtro-categoria').value.toLowerCase();
    const busq = document.getElementById('busqueda-nombre').value.toLowerCase();

    if(cat !== 'todos') filtrados = filtrados.filter(c=>c.getAttribute('data-rubro') === cat);
    if(busq!=='') filtrados = filtrados.filter(c=>c.querySelector('h2').textContent.toLowerCase().includes(busq));

    if (viendoSoloFavoritos) {
        filtrados = filtrados.filter(c => misFavoritos.includes(c.getAttribute('data-nombre')));
    }

    const abiertos = filtrados.filter(c=>c.querySelector('.estado').classList.contains('abierto'));
    const cerrados = filtrados.filter(c=>!c.querySelector('.estado').classList.contains('abierto'));

    const shuffle = (array) => array.sort(() => Math.random() - 0.5);
    filtrados = [...shuffle(abiertos), ...shuffle(cerrados)];
    mostrarPagina(filtrados, 1);
}

function cargarLogo(img){
    img.onerror = ()=> img.src = 'https://ui-avatars.com/api/?background=0284C7&color=fff&size=128&name=Negocio';
}

// --- CARGA DE DATOS DESDE GOOGLE APPS SCRIPT ---
async function cargarNegocios() {
    try {
        const res = await fetch(scriptURL);
        const negocios = await res.json();

        const container = document.getElementById('negocios-container');
        container.innerHTML = '';

        negocios.forEach(n=>{
            const card = document.createElement('div');
            card.classList.add('negocio-card');
            
            card.setAttribute('data-nombre', n.Nombre); 
            card.setAttribute('data-rubro', n.Rubro.toLowerCase());
            ["Lunes","Martes","Miércoles","Jueves","Viernes","Sábado","Domingo"].forEach(d => {
                card.setAttribute('data-'+d.toLowerCase(), n[d] || 'Cerrado');
            });

            const formasPago = n["Formas de pago"] || n["Formas de Pago"] || 'Consultar';
            const tieneDelivery = n.Delivery === true;

            let rawCosto = n["Costo Delivery"]; 
            let horarioDelivery = n["Horario Delivery"] || "";
            let htmlCosto = "";

            if (rawCosto !== undefined && rawCosto !== "") {
                if (rawCosto == 0 || String(rawCosto).toLowerCase().includes("gratis")) {
                    htmlCosto = `<span class="costo-gratis">¡GRATIS!</span>`;
                } else {
                    const esNumero = !isNaN(rawCosto);
                    htmlCosto = `<span class="costo-precio">${esNumero ? '$' + rawCosto : rawCosto}</span>`;
                }
            }

            let bloqueDelivery = "";
            if (tieneDelivery && (htmlCosto || horarioDelivery)) {
                bloqueDelivery = `
                <div class="delivery-info-box">
                    ${htmlCosto ? `<div class="delivery-row"><i class="fas fa-motorcycle"></i> <span>Envío: ${htmlCosto}</span></div>` : ''}
                    ${horarioDelivery ? `<div class="delivery-row"><i class="far fa-clock"></i> <span>${horarioDelivery}</span></div>` : ''}
                </div>`;
            }

            card.innerHTML = `
                <button class="btn-favorito" title="Agregar a favoritos">
                    <i class="far fa-heart"></i>
                </button>

                <div class="card-header">
                    <img src="${n["Logo URL"]}" alt="Logo" class="logo">
                    <div class="info-principal">
                        <h2>${n.Nombre}</h2>
                        <span class="rubro">${n.Rubro}</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <i class="fas fa-map-marker-alt"></i> 
                        <span>${n.Domicilio}</span>
                    </div>
                    <div class="horarios-concisos"></div>
                    <div class="info-row payment">
                        <i class="fas fa-credit-card"></i> 
                        <span>${formasPago}</span>
                    </div>
                    ${bloqueDelivery} ${n.Banner && n.Banner.trim() !== "" 
                        ? `<div class="banner-simple"><i class="fas fa-bullhorn"></i> ${n.Banner}</div>` 
                        : ""
                    }
                    <div class="estado-container">
                        <span class="estado">Cargando...</span>
                    </div>
                </div>
                <div class="delivery-badge ${tieneDelivery ? 'has-delivery' : ''}" 
                     title="${tieneDelivery ? 'Hacen envíos' : 'Sin envío'}">
                    <i class="fas fa-motorcycle"></i>
                </div>
            `;

            cargarLogo(card.querySelector('.logo'));
            
            card.addEventListener('click', ()=> window.open(n.URL,'_blank'));
            
            const favBtn = card.querySelector('.btn-favorito');
            favBtn.addEventListener('click', (e) => {
                e.stopPropagation(); 
                guardarFavorito(n.Nombre);
                favBtn.style.transform = "scale(1.3)";
                setTimeout(()=> favBtn.style.transform = "scale(1)", 200);
            });

            container.appendChild(card);
        });

        allCards = Array.from(document.querySelectorAll('.negocio-card'));
        actualizarEstados();
        actualizarBotonesCorazon(); 

        const selectCat = document.getElementById('filtro-categoria');
        const categorias = new Set();
        allCards.forEach(card=> categorias.add(card.getAttribute('data-rubro')));
        Array.from(categorias).sort().forEach(cat=>{
            const option = document.createElement('option');
            option.value = cat;
            option.textContent = cat.charAt(0).toUpperCase() + cat.slice(1);
            selectCat.appendChild(option);
        });

        aplicarFiltros();
        document.getElementById('spinner').style.opacity = '0';
        setTimeout(() => document.getElementById('spinner').style.display = 'none', 300);

    } catch (error) {
        console.error("Error cargando negocios", error);
        document.getElementById('spinner').innerHTML = '<p style="color:#ef4444; text-align:center; font-weight:700;">Error al cargar datos.<br>Intenta recargar la página.</p>';
    }
}

document.addEventListener('DOMContentLoaded', ()=>{
    AOS.init({ duration: 800, once: true, offset: 50 });
    
    cargarNegocios();
    document.getElementById('filtro-categoria').addEventListener('change', aplicarFiltros);
    document.getElementById('busqueda-nombre').addEventListener('input', aplicarFiltros);

    const btnToggleFav = document.getElementById('btn-toggle-favoritos');
    const iconToggle = document.getElementById('icon-toggle-fav');
    const textToggle = document.getElementById('text-toggle-fav');

    btnToggleFav.addEventListener('click', () => {
        viendoSoloFavoritos = !viendoSoloFavoritos; 
        
        if (viendoSoloFavoritos) {
            btnToggleFav.classList.add('activo-filtro');
            iconToggle.classList.replace('far', 'fas');
            textToggle.textContent = "Ver Todos";
        } else {
            btnToggleFav.classList.remove('activo-filtro');
            iconToggle.classList.replace('fas', 'far');
            textToggle.textContent = "Ver mis Favoritos";
        }
        aplicarFiltros(); 
    });
});
</script>

