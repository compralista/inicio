<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Compra Lista - La guía definitiva de comercios y servicios en Carpintería, San Luis.">
    <title>Compra Lista | Guía de Comercios y Servicios en Carpintería</title>
    
    <!-- Fuentes y Estilos Visuales de Index 23 -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        /* --- VARIABLES DE INDEX 23 (MODO CLARO) --- */
        :root {
            --primary-color: #0284C7; 
            --primary-dark: #0369A1;
            --primary-light: rgba(2, 132, 199, 0.1);
            --text-dark: #0F172A;
            --text-gray: #475569;
            --bg-light: #F8FAFC;
            --white: #FFFFFF;
            --nav-bg: rgba(255, 255, 255, 0.85);
            --border-color: #E2E8F0;
            --pattern-color: #cbd5e1;
            --wa-green: #25D366;
            --font-main: 'Inter', sans-serif;
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            --transition-speed: 0.4s;
            --radius: 20px;
        }

        /* --- VARIABLES DE INDEX 23 (MODO OSCURO) --- */
        [data-theme="dark"] {
            --text-dark: #F8FAFC;
            --text-gray: #94A3B8;
            --bg-light: #0F172A;
            --white: #1E293B;
            --nav-bg: rgba(30, 41, 59, 0.85);
            --border-color: #334155;
            --pattern-color: #334155;
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.4);
            --primary-light: rgba(2, 132, 199, 0.2);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; overflow-x: hidden; }
        
        body { 
            font-family: var(--font-main); 
            color: var(--text-dark); 
            background-color: var(--white); 
            line-height: 1.6; 
            transition: background-color var(--transition-speed), color var(--transition-speed); 
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }
        
        /* --- NAVBAR ESTILO CRISTAL --- */
        .navbar {
            position: fixed; width: 100%; top: 0; background-color: var(--nav-bg);
            backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
            z-index: 1000; border-bottom: 1px solid var(--border-color); 
            transition: all var(--transition-speed);
        }
        .nav-container { 
            width: 90%; max-width: 1280px; margin: 0 auto;
            display: flex; justify-content: space-between; align-items: center; height: 75px; 
        }
        .logo { font-size: 1.6rem; font-weight: 800; color: var(--text-dark); text-decoration: none; letter-spacing: -0.5px; transition: transform 0.3s; }
        .logo:hover { transform: scale(1.03); }
        .logo span { color: var(--primary-color); }

        .nav-right { display: flex; align-items: center; gap: 15px; }

        /* --- BOTÓN THEME TOGGLE (MODERNO Y ANIMADO DE INDEX 23) --- */
        .theme-toggle {
            background: var(--bg-light); border: 1px solid var(--border-color); cursor: pointer;
            width: 42px; height: 42px; border-radius: 50%; transition: all 0.3s ease;
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }
        .theme-toggle:hover { background-color: var(--border-color); box-shadow: var(--shadow-sm); }
        .theme-toggle svg {
            position: absolute; width: 20px; height: 20px;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .moon-icon { opacity: 1; transform: translateY(0) rotate(0deg); color: var(--text-gray); }
        .sun-icon { opacity: 0; transform: translateY(30px) rotate(45deg); color: #F59E0B; }
        [data-theme="dark"] .moon-icon { opacity: 0; transform: translateY(-30px) rotate(-45deg); }
        [data-theme="dark"] .sun-icon { opacity: 1; transform: translateY(0) rotate(0deg); }

        /* --- HERO SECTION CON PATRÓN DINÁMICO --- */
        .hero {
            padding: 150px 20px 60px; 
            background-color: var(--bg-light);
            background-image: radial-gradient(var(--pattern-color) 1.5px, transparent 1.5px);
            background-size: 35px 35px; text-align: center;
            transition: background-color var(--transition-speed);
            position: relative;
            margin-bottom: 40px;
            border-bottom: 1px solid var(--border-color);
        }
        .hero-badge {
            display: inline-block; background-color: var(--primary-light); color: var(--primary-color);
            padding: 8px 18px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-bottom: 20px;
            border: 1px solid rgba(2, 132, 199, 0.2);
        }
        .hero h1 { font-size: 3.2rem; font-weight: 800; line-height: 1.15; margin-bottom: 15px; letter-spacing: -1px; }
        .hero h1 span { 
            color: var(--primary-color); 
            background: linear-gradient(90deg, var(--primary-color), #0EA5E9);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero p { font-size: 1.15rem; color: var(--text-gray); max-width: 650px; margin: 0 auto; }

        /* --- LAYOUT PRINCIPAL --- */
        .container { 
            display: flex; 
            max-width: 1280px; 
            margin: 0 auto; 
            padding: 0 20px; 
            gap: 30px;
        }

        /* --- SIDEBAR (FILTROS) ESTILO INDEX 23 --- */
        .sidebar { 
            width: 300px; 
            flex-shrink: 0;
            background: var(--white); 
            padding: 28px; 
            border-radius: var(--radius); 
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md); 
            height: fit-content;
            position: sticky; 
            top: 100px;
            transition: all var(--transition-speed);
        }
        .sidebar h3 { font-size: 1.2rem; font-weight: 800; color: var(--text-dark); margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
        .sidebar h3 i { color: var(--primary-color); }

        .filter-group { margin-bottom: 20px; }
        .filter-group label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 0.9rem; color: var(--text-dark); }
        .filter-group input, .filter-group select { 
            width: 100%; 
            padding: 12px 15px; 
            border: 1px solid var(--border-color); 
            border-radius: 12px; 
            background-color: var(--bg-light); 
            color: var(--text-dark);
            font-size: 0.95rem; 
            transition: all 0.3s;
            outline: none;
            font-family: var(--font-main);
            box-sizing: border-box;
        }
        .filter-group input:focus, .filter-group select:focus {
            border-color: var(--primary-color);
            background-color: var(--white);
            box-shadow: 0 0 0 3px var(--primary-light);
        }

        /* BOTÓN FAVORITOS EN SIDEBAR */
        .toggle-fav-container {
            margin-bottom: 20px;
            background: rgba(239, 68, 68, 0.08);
            padding: 12px;
            border-radius: 12px;
            border: 1px dashed rgba(239, 68, 68, 0.3);
            text-align: center;
        }
        .btn-ver-favoritos {
            background: transparent;
            border: none;
            color: #ef4444;
            font-weight: 700;
            font-family: var(--font-main);
            cursor: pointer;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            transition: all 0.3s;
        }
        .btn-ver-favoritos.activo-filtro {
            background: #ef4444;
            color: white;
            padding: 10px;
            border-radius: 10px;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
        }

        /* --- LISTA DE NEGOCIOS --- */
        .negocios-list { 
            flex-grow: 1; 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); 
            gap: 25px;
            align-content: start;
        }

        /* --- TARJETA DE NEGOCIO (ESTILO INDEX 23) --- */
        .negocio-card { 
            background: var(--white); 
            border-radius: var(--radius); 
            box-shadow: var(--shadow-md); 
            transition: all 0.4s ease; 
            position: relative; 
            cursor: pointer;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .negocio-card:hover { 
            transform: translateY(-8px); 
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-color);
        }

        /* Header de la tarjeta */
        .card-header { 
            display: flex; 
            align-items: center; 
            padding: 20px; 
            border-bottom: 1px solid var(--border-color);
            background: transparent;
        }

        .logo { 
            width: 60px; 
            height: 60px; 
            border-radius: 50%; 
            object-fit: cover; 
            margin-right: 15px; 
            border: 2px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }

        .info-principal { flex: 1; padding-right: 30px; }
        .info-principal h2 { font-size: 1.15rem; font-weight: 700; color: var(--text-dark); line-height: 1.3; margin-bottom: 6px; }
        .info-principal .rubro { 
            font-size: 0.75rem; 
            color: var(--primary-color); 
            font-weight: 700; 
            text-transform: uppercase; 
            letter-spacing: 0.5px;
            background: var(--primary-light);
            padding: 4px 10px;
            border-radius: 20px;
            display: inline-block;
        }

        /* Cuerpo de la tarjeta */
        .card-body { padding: 20px; flex-grow: 1; display: flex; flex-direction: column; gap: 12px; }

        .info-row { display: flex; align-items: flex-start; gap: 10px; color: var(--text-gray); font-size: 0.9rem; }
        .info-row i { color: var(--primary-color); margin-top: 3px; width: 16px; text-align: center; }
        .info-row.payment i { color: #3b82f6; }

        .horarios-concisos { 
            font-size: 0.85rem; 
            color: var(--text-gray); 
            background: var(--bg-light);
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            line-height: 1.5;
        }

        /* DELIVERY INFO BOX */
        .delivery-info-box {
            background-color: rgba(245, 158, 11, 0.08);
            border: 1px dashed rgba(245, 158, 11, 0.4);
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 0.85rem;
            color: var(--text-dark);
        }

        .delivery-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
        .delivery-row:last-child { margin-bottom: 0; }
        .delivery-row i { color: #f59e0b; width: 16px; text-align: center; }

        .costo-gratis { color: #10b981; font-weight: 800; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; }
        .costo-precio { font-weight: 700; color: var(--text-dark); }

        /* Estados */
        .estado-container { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 10px; }

        .estado { 
            padding: 6px 14px; 
            border-radius: 20px; 
            font-weight: 700; 
            font-size: 0.75rem; 
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .estado::before { content: ''; width: 8px; height: 8px; border-radius: 50%; display: block; }

        .estado.abierto { background-color: rgba(34, 197, 94, 0.12); color: #16a34a; }
        .estado.abierto::before { background-color: #16a34a; }

        .estado.cerrado { background-color: rgba(239, 68, 68, 0.12); color: #ef4444; }
        .estado.cerrado::before { background-color: #ef4444; }

        [data-theme="dark"] .estado.abierto { color: #4ade80; background-color: rgba(74, 222, 128, 0.15); }
        [data-theme="dark"] .estado.abierto::before { background-color: #4ade80; }
        [data-theme="dark"] .estado.cerrado { color: #f87171; background-color: rgba(248, 113, 113, 0.15); }
        [data-theme="dark"] .estado.cerrado::before { background-color: #f87171; }

        /* Icono Delivery flotante */
        .delivery-badge {
            position: absolute;
            top: 60px; right: 15px;
            font-size: 1.1rem; color: var(--text-gray); opacity: 0.2;
        }
        .delivery-badge.has-delivery {
            color: #f59e0b; opacity: 1;
            background: rgba(245, 158, 11, 0.12);
            width: 36px; height: 36px;
            display: flex; align-items: center; justify-content: center;
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.2);
        }

        /* Banner de Oferta */
        .banner-simple {
            background: linear-gradient(90deg, rgba(245, 158, 11, 0.15) 0%, rgba(245, 158, 11, 0.05) 100%);
            color: #d97706;
            padding: 8px 12px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 8px;
            border-left: 3px solid #f59e0b;
        }

        /* FAVORITOS */
        .btn-favorito {
            position: absolute;
            top: 15px; right: 15px;
            background: var(--white);
            border: 1px solid var(--border-color);
            width: 36px; height: 36px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; z-index: 10;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s;
            font-size: 1.1rem;
            color: var(--text-gray);
        }
        .btn-favorito:hover { transform: scale(1.15); color: #ef4444; }
        .btn-favorito.activo {
            color: #ef4444; 
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }

        /* Botones Paginación */
        .page-buttons { text-align: center; margin: 40px 0; }
        .page-buttons button { 
            margin: 0 4px; 
            width: 42px; 
            height: 42px; 
            border: 1px solid var(--border-color); 
            border-radius: 12px; 
            background: var(--white); 
            color: var(--text-dark); 
            cursor: pointer; 
            font-weight: 700;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s;
        }
        .page-buttons button:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: var(--primary-color); }
        .page-buttons button.active { background: var(--primary-color); color: white; border-color: var(--primary-color); transform: scale(1.05); }

        /* Spinner */
        #spinner {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-light); opacity: 0.95;
            display: flex; flex-direction: column; gap: 15px;
            align-items: center; justify-content: center;
            z-index: 9999;
            transition: opacity 0.3s ease;
        }
        .spinner-icon { font-size: 3rem; color: var(--primary-color); }
        .spinner-text { font-family: var(--font-main); font-weight: 700; color: var(--text-dark); }

        /* --- FOOTER & CTA ESTILO INDEX 23 --- */
        footer {
            background-color: var(--white);
            color: var(--text-gray);
            padding: 80px 20px 40px;
            margin-top: 100px;
            border-top: 1px solid var(--border-color);
            transition: all var(--transition-speed);
        }
        .footer-content { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }

        .cta-section {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
            color: #fff;
            padding: 45px 35px;
            border-radius: 24px;
            box-shadow: var(--shadow-lg);
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            transform: translateY(-110px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .cta-section::before { content: '🚀'; position: absolute; right: -20px; top: -20px; font-size: 8rem; opacity: 0.05; }
        .cta-section h3 { color: #fff; margin-bottom: 12px; font-size: 1.8rem; font-weight: 800; }
        .cta-section p { margin-bottom: 25px; color: #94A3B8; max-width: 500px; font-size: 1.05rem; }

        .btn-whatsapp {
            display: inline-flex; align-items: center; gap: 10px;
            background-color: var(--wa-green); color: white;
            padding: 16px 32px; border-radius: 50px;
            text-decoration: none; font-weight: 700;
            transition: all 0.3s;
            box-shadow: 0 10px 20px -5px rgba(37, 211, 102, 0.4);
        }
        .btn-whatsapp:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 15px 25px -5px rgba(37, 211, 102, 0.6);
        }

        .copyright-bar {
            margin-top: -50px;
            text-align: center;
            width: 100%;
            font-size: 0.9rem;
            color: var(--text-gray);
        }

        /* Botón Flotante WA de Index 23 */
        .wa-float {
            position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px;
            background-color: var(--wa-green); border-radius: 50%; display: flex;
            align-items: center; justify-content: center; color: #fff;
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.4); z-index: 999; transition: all 0.3s;
        }
        .wa-float:hover { transform: scale(1.15) rotate(-5deg); }

        /* Responsive */
        @media(max-width: 992px){
            .container { flex-direction: column; }
            .sidebar { width: 100%; position: static; margin-bottom: 20px; }
            .hero h1 { font-size: 2.3rem; }
            .cta-section { transform: translateY(-80px); padding: 30px 20px; }
            .copyright-bar { margin-top: -40px; }
        }
    </style>
</head>
<body>

